{
  "schema_version": "kospi200-fundamental-factor-contract-v2-legacy-2011",
  "universe": "KOSPI_200_POINT_IN_TIME",
  "availability_rule": "DART_RECEIPT_DATE_NEXT_KRX_SESSION",
  "statement_preference": ["CFS"],
  "minimum_standard_year": 2011,
  "source_partitions": {
    "legacy_dart": "2011-03-31_to_2014-12-31_exact_top_level_labels",
    "opendart_xbrl": "2015_to_2023_standard_account_ids"
  },
  "factor_ids": [
    "roe", "roa", "operating_margin", "net_margin", "cfo_to_assets",
    "earnings_yield", "book_to_market", "sales_to_market_cap", "cfo_yield", "free_cash_flow_yield",
    "debt_to_equity", "liabilities_to_assets", "current_ratio", "cash_to_assets", "equity_ratio",
    "revenue_growth_yoy", "operating_income_growth_yoy", "net_income_growth_yoy",
    "assets_growth_yoy", "equity_growth_yoy"
  ],
  "cross_sectional_transforms": ["percentile", "robust_z_clip_5"],
  "missing_value_policy": "NO_FORWARD_OR_CROSS_PERIOD_IMPUTATION",
  "not_allowed": ["guidance", "news", "filing_text_embedding", "future_revision", "protected_oos_access"],
  "model_training_allowed": false
}
