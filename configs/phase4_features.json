  "decision_rules": {
    "accept": "coverage>=0.95 and train_mean_ic>0 and validation_mean_ic>0 and validation_hac_t>=1.0 and at_least_2_positive_validation_years and not_redundant",
    "hold_unstable": "direction_or_validation_stability_gate_failed",
    "hold_redundant": "absolute_train_rank_correlation>=0.90_with_stronger_accepted_feature",
    "reject_missing": "coverage<0.95",
