    "revenue": {"statement_div": ["IS", "CIS"], "account_ids": ["ifrs-full_Revenue", "ifrs_Revenue"]},
    "operating_income": {"statement_div": ["IS", "CIS"], "account_ids": ["dart_OperatingIncomeLoss"]},
