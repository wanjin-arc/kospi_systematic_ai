{
  "version": "phase5b-multifactor-ranking-v1",
  "experiment_id": "EXP-20260823-002",
  "phase4b_experiment_id": "EXP-20260823-001",
  "phase4b_config": "configs/phase4b_multifactor.json",
  "data_root": "data/processed/v24/phase4b_train_internal_2018",
  "required_partition_role": "phase4b_train_internal",
  "maximum_permitted_date": "2018-12-31",
  "development_test_access": false,
  "final_oos_access": "DENIED_UNTIL_PHASE_8",
  "target": {
    "id": "forward_10_session_excess_open_to_open_rank",
    "entry_offset_sessions": 1,
    "exit_offset_sessions": 11,
    "cross_sectional_transform": "percentile_rank_average"
  },
  "models": {
    "candidate_order": [
      "equal_weight_rank",
      "ridge_a1",
      "ridge_a100",
      "elastic_a005_l02",
      "histgb_d2_l200",
      "histgb_d3_l200",
      "blend_ridge_histgb"
    ],
    "ridge_alpha": [1.0, 100.0],
    "elastic_net": {"alpha": 0.005, "l1_ratio": 0.2, "max_iter": 10000, "tol": 0.00002},
    "hist_gradient_boosting": {
      "max_depth": [2, 3],
      "learning_rate": 0.05,
      "max_iter": 150,
      "min_samples_leaf": 200,
      "l2_regularization": 1.0,
      "early_stopping": false
    },
    "blend": {"ridge_candidate": "ridge_a100", "histgb_candidate": "histgb_d3_l200", "ridge_weight": 0.5, "histgb_weight": 0.5}
  },
  "portfolio": {
    "initial_cash_krw": "5000000",
    "holding_sessions": 10,
    "maximum_holdings": 10,
    "target_weight": "0.10",
    "allow_pyramiding": false,
    "entry_gap_cap": "0.05",
    "whole_shares_only": true,
    "unallocated_cash": "retain",
    "entry_priority": "daily_score_desc_security_id_asc"
  },
  "costs": {
    "commission_rate_per_side": "0.0002",
    "slippage_rate_per_side": "0.0010",
    "stress_multipliers": [1, 2, 3],
    "sell_tax_schedule": "configs/kospi_sell_cost_schedule.csv",
    "tax_removed_in_stress": false
  },
  "selection": {
    "partition": "2015_2018_internal_validation_only",
    "required_nonnegative_annual_excess_folds": 4,
    "required_connected_net_excess_return": 0.0,
    "objective_after_gate": "highest_connected_base_cost_net_excess_return",
    "tie_breaks": ["higher_net_sharpe", "shallower_max_drawdown", "lower_turnover", "lower_model_complexity", "fixed_candidate_order"],
    "if_no_candidate_passes": "reject_all_and_record_diagnostic_best",
    "development_test_runs": 0
  },
  "purge_sessions": 20,
  "embargo_sessions": 20,
  "minimum_cross_section": 30,
  "random_seed": 20260823,
  "run_command": "PYTHONPATH=src python -m kospi100_multifactor.cli select --config configs/phase5b_multifactor_ranking.json --output artifacts/phase5b/selection"
}
